{
	"name": "@base-framework/ui",
	"version": "1.3.7",
	"description": "This is a UI package that adds components and atoms that use Tailwind CSS and a theme based on Shadcn.",
	"main": "./dist/index.js",
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc",
		"preview": "vite preview"
	},
	"type": "module",
	"sideEffects": false,
	"keywords": [
		"JavaScript",
		"Framework",
		"Base",
		"ES6",
		"UI"
	],
	"author": "Chris Durfee",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chrisdurfee/ui.git"
	},
	"bugs": {
		"url": "https://github.com/chrisdurfee/ui/issues"
	},
	"devDependencies": {
		"@base-framework/atoms": "^1.0.41",
		"@base-framework/base": "^3.0.295",
		"@base-framework/organisms": "^1.0.69",
		"@tailwindcss/vite": "^4.1.12",
		"esbuild": "^0.25.0",
		"tailwindcss": "^4.1.12",
		"typescript": "^5.7.3",
		"vite": "^7.1.0"
	},
	"peerDependencies": {
		"@base-framework/atoms": "^1.0.41",
		"@base-framework/base": "^3.0.295",
		"@base-framework/organisms": "^1.0.69"
	},
	"types": "./dist/types/ui.d.ts",
	"files": [
		"package.json",
		"readme.md",
		"copilot.md",
		"dist"
	],
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/types/ui.d.ts",
			"import": "./dist/index.js"
		},
		"./atoms": {
			"types": "./dist/types/components/atoms/atoms.d.ts",
			"import": "./dist/atoms.js"
		},
		"./icons": {
			"types": "./dist/types/components/icons/icons.d.ts",
			"import": "./dist/icons.js"
		},
		"./molecules": {
			"types": "./dist/types/components/molecules/molecules.d.ts",
			"import": "./dist/molecules.js"
		},
		"./organisms": {
			"types": "./dist/types/components/organisms/organisms.d.ts",
			"import": "./dist/organisms.js"
		},
		"./utils": {
			"types": "./dist/types/utils/utils.d.ts",
			"import": "./dist/utils.js"
		},
		"./pages": {
			"types": "./dist/types/components/pages/pages.d.ts",
			"import": "./dist/pages.js"
		},
		"./templates": {
			"types": "./dist/types/components/pages/templates/templates.d.ts",
			"import": "./dist/templates.js"
		},
		"./copilot.md": "./copilot.md"
	},
	"homepage": "https://github.com/chrisdurfee/ui#readme"
}
